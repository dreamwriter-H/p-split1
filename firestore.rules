rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isVerifiedGoogleUser() {
      return isGoogleUser()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function appOwnerPath() {
      return /databases/$(database)/documents/apps/spliteasy-v2-2-prod/accessConfig/owner;
    }

    function accessAccountPath(uid) {
      return /databases/$(database)/documents/apps/spliteasy-v2-2-prod/accessAccounts/$(uid);
    }

    function isAppOwner() {
      return isVerifiedGoogleUser() && exists(appOwnerPath())
        && get(appOwnerPath()).data.email == request.auth.token.email.lower();
    }

    function hasAppAccess() {
      return isVerifiedGoogleUser() && (isAppOwner() || (
        exists(accessAccountPath(request.auth.uid))
        && get(accessAccountPath(request.auth.uid)).data.email == request.auth.token.email.lower()
        && get(accessAccountPath(request.auth.uid)).data.status == 'approved'
      ));
    }

    match /apps/spliteasy-v2-2-prod/accessConfig/owner {
      allow get: if isVerifiedGoogleUser() && resource.data.email == request.auth.token.email.lower();
    }

    match /apps/spliteasy-v2-2-prod/accessAccounts/{uid} {
      function isOwnAccount() {
        return isVerifiedGoogleUser() && request.auth.uid == uid;
      }

      allow get: if isOwnAccount() || isAppOwner();
      allow list: if isAppOwner();
      allow create: if isOwnAccount()
        && request.resource.data.keys().hasOnly(['email', 'name', 'status', 'firstSeenAt', 'lastSeenAt'])
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.status == 'pending'
        && request.resource.data.firstSeenAt == request.time
        && request.resource.data.lastSeenAt == request.time;
      allow update: if (isOwnAccount()
        && resource.data.email == request.auth.token.email.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastSeenAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.lastSeenAt == request.time)
        || (isAppOwner() && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusChangedAt'])
        && request.resource.data.status in ['approved', 'blocked']
        && request.resource.data.statusChangedAt == request.time);
    }

    function productionProjectPath(projectId) {
      return /databases/$(database)/documents/apps/spliteasy-v2-2-prod/projects/$(projectId);
    }

    function productionMemberPath(projectId, uid) {
      return /databases/$(database)/documents/apps/spliteasy-v2-2-prod/projects/$(projectId)/members/$(uid);
    }

    function productionInvitePath(projectId, inviteId) {
      return /databases/$(database)/documents/apps/spliteasy-v2-2-prod/projects/$(projectId)/invites/$(inviteId);
    }

    function isProductionMember(projectId) {
      return hasAppAccess()
        && exists(productionMemberPath(projectId, request.auth.uid));
    }

    function isProductionOwner(projectId) {
      return hasAppAccess()
        && get(productionProjectPath(projectId)).data.ownerId == request.auth.uid;
    }

    function isProductionOwnerAfterWrite(projectId) {
      return hasAppAccess()
        && getAfter(productionProjectPath(projectId)).data.ownerId == request.auth.uid;
    }

    function hasActiveProductionInvite(projectId, inviteId) {
      return hasAppAccess()
        && exists(productionInvitePath(projectId, inviteId))
        && get(productionInvitePath(projectId, inviteId)).data.status == 'active';
    }

    // Once a project uses recovery-aware writes, every update must advance its
    // revision and rotate its token. Older clients only copy/remove these fields;
    // even an older, different token cannot replay a stale project revision.
    // This is a compatibility gate, not an immutable audit log or security secret.
    function validRecoveryWrite() {
      return !resource.data.keys().hasAny(['recoveryWriteToken', 'recoveryWriteRevision'])
        || (
          request.resource.data.keys().hasAll(['recoveryWriteToken', 'recoveryWriteRevision'])
          && request.resource.data.recoveryWriteToken is string
          && request.resource.data.recoveryWriteToken.size() >= 16
          && request.resource.data.recoveryWriteToken != resource.data.get('recoveryWriteToken', '')
          && request.resource.data.recoveryWriteRevision is int
          && request.resource.data.recoveryWriteRevision == resource.data.get('recoveryWriteRevision', 0) + 1
        );
    }

    // v2.2 正式資料：專案、成員與邀請只存在全新的正式資料空間。
    match /apps/spliteasy-v2-2-prod/projects/{projectId} {
      allow create: if hasAppAccess()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.schemaVersion == '2.2.0'
        && request.resource.data.type in ['dining', 'travel']
        && request.resource.data.keys().hasAll([
          'id', 'name', 'type', 'ownerId', 'createdAt', 'updatedAt', 'data'
        ]);

      allow get: if isProductionMember(projectId);
      allow list: if false;

      allow update: if isProductionMember(projectId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.type == resource.data.type
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && validRecoveryWrite();

      allow delete: if isProductionOwner(projectId);

      match /members/{memberId} {
        allow get, list: if isProductionMember(projectId);

        allow create: if hasAppAccess()
          && memberId == request.auth.uid
          && request.resource.data.role in ['owner', 'editor']
          && (
            (
              request.resource.data.role == 'owner'
              && isProductionOwnerAfterWrite(projectId)
            )
            ||
            (
              request.resource.data.role == 'editor'
              && request.resource.data.keys().hasAll(['inviteId'])
              && hasActiveProductionInvite(projectId, request.resource.data.inviteId)
            )
          );

        allow update: if isProductionOwner(projectId);
        allow delete: if isProductionOwner(projectId)
          || (hasAppAccess() && memberId == request.auth.uid);
      }

      match /invites/{inviteId} {
        allow get: if hasAppAccess();
        allow list: if isProductionOwner(projectId);
        allow create: if isProductionOwner(projectId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isProductionOwner(projectId)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isProductionOwner(projectId);
      }
    }

    // 每位使用者只能讀寫自己的 v2.2 正式專案索引；專案擁有者可同步清理已移除成員的索引。
    match /users/{userId}/spaces/spliteasy-v2-2-prod/projects/{projectId} {
      allow get, list: if hasAppAccess() && userId == request.auth.uid;

      allow create: if hasAppAccess()
        && userId == request.auth.uid
        && request.resource.data.role in ['owner', 'editor']
        && (
          (
            request.resource.data.role == 'owner'
            && isProductionOwnerAfterWrite(projectId)
          )
          ||
          (
            request.resource.data.role == 'editor'
            && existsAfter(productionMemberPath(projectId, request.auth.uid))
          )
        );

      allow update: if hasAppAccess() && userId == request.auth.uid;

      allow delete: if hasAppAccess()
        && (userId == request.auth.uid || isProductionOwner(projectId));
    }

    // 正式切換後凍結舊 v2.1 與 v2.2 預覽資料，避免舊分頁在永久清除後寫回。
    match /apps/spliteasy-v2/projects/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/projects/{document=**} {
      allow read, write: if false;
    }

    match /apps/spliteasy-v2-2-preview/projects/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/spaces/spliteasy-v2-2-preview/projects/{document=**} {
      allow read, write: if false;
    }

    // v1 舊路徑全面停用。
    match /artifacts/{document=**} {
      allow read, write: if false;
    }
  }
}
