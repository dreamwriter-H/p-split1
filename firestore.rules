rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function productionProjectPath(projectId) {
      return /databases/$(database)/documents/apps/spliteasy-v2-2-prod/projects/$(projectId);
    }

    function productionMemberPath(projectId, uid) {
      return /databases/$(database)/documents/apps/spliteasy-v2-2-prod/projects/$(projectId)/members/$(uid);
    }

    function productionInvitePath(projectId, inviteId) {
      return /databases/$(database)/documents/apps/spliteasy-v2-2-prod/projects/$(projectId)/invites/$(inviteId);
    }

    function isProductionMember(projectId) {
      return isGoogleUser()
        && exists(productionMemberPath(projectId, request.auth.uid));
    }

    function isProductionOwner(projectId) {
      return isGoogleUser()
        && get(productionProjectPath(projectId)).data.ownerId == request.auth.uid;
    }

    function isProductionOwnerAfterWrite(projectId) {
      return isGoogleUser()
        && getAfter(productionProjectPath(projectId)).data.ownerId == request.auth.uid;
    }

    function hasActiveProductionInvite(projectId, inviteId) {
      return isGoogleUser()
        && exists(productionInvitePath(projectId, inviteId))
        && get(productionInvitePath(projectId, inviteId)).data.status == 'active';
    }

    // v2.2 正式資料：專案、成員與邀請只存在全新的正式資料空間。
    match /apps/spliteasy-v2-2-prod/projects/{projectId} {
      allow create: if isGoogleUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.schemaVersion == '2.2.0'
        && request.resource.data.type in ['dining', 'travel']
        && request.resource.data.keys().hasAll([
          'id', 'name', 'type', 'ownerId', 'createdAt', 'updatedAt', 'data'
        ]);

      allow get: if isProductionMember(projectId);
      allow list: if false;

      allow update: if isProductionMember(projectId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.type == resource.data.type
        && request.resource.data.schemaVersion == resource.data.schemaVersion;

      allow delete: if isProductionOwner(projectId);

      match /members/{memberId} {
        allow get, list: if isProductionMember(projectId);

        allow create: if isGoogleUser()
          && memberId == request.auth.uid
          && request.resource.data.role in ['owner', 'editor']
          && (
            (
              request.resource.data.role == 'owner'
              && isProductionOwnerAfterWrite(projectId)
            )
            ||
            (
              request.resource.data.role == 'editor'
              && request.resource.data.keys().hasAll(['inviteId'])
              && hasActiveProductionInvite(projectId, request.resource.data.inviteId)
            )
          );

        allow update: if isProductionOwner(projectId);
        allow delete: if isProductionOwner(projectId)
          || (isGoogleUser() && memberId == request.auth.uid);
      }

      match /invites/{inviteId} {
        allow get: if isGoogleUser();
        allow list: if isProductionOwner(projectId);
        allow create: if isProductionOwner(projectId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isProductionOwner(projectId)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isProductionOwner(projectId);
      }
    }

    // 每位使用者只能讀寫自己的 v2.2 正式專案索引；專案擁有者可同步清理已移除成員的索引。
    match /users/{userId}/spaces/spliteasy-v2-2-prod/projects/{projectId} {
      allow get, list: if isGoogleUser() && userId == request.auth.uid;

      allow create: if isGoogleUser()
        && userId == request.auth.uid
        && request.resource.data.role in ['owner', 'editor']
        && (
          (
            request.resource.data.role == 'owner'
            && isProductionOwnerAfterWrite(projectId)
          )
          ||
          (
            request.resource.data.role == 'editor'
            && existsAfter(productionMemberPath(projectId, request.auth.uid))
          )
        );

      allow update: if isGoogleUser() && userId == request.auth.uid;

      allow delete: if isGoogleUser()
        && (userId == request.auth.uid || isProductionOwner(projectId));
    }

    // 正式切換後凍結舊 v2.1 與 v2.2 預覽資料，避免舊分頁在永久清除後寫回。
    match /apps/spliteasy-v2/projects/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/projects/{document=**} {
      allow read, write: if false;
    }

    match /apps/spliteasy-v2-2-preview/projects/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/spaces/spliteasy-v2-2-preview/projects/{document=**} {
      allow read, write: if false;
    }

    // v1 舊路徑全面停用。
    match /artifacts/{document=**} {
      allow read, write: if false;
    }
  }
}
